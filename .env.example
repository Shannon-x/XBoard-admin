# --------------------------------------------------------------------------
# XBoard-admin 环境变量示例
#
# 注意：本前端是 SPA，构建产物会暴露给所有访问者。
# **不要在这里写任何真实凭据 / token / 私钥**，所有以 `VITE_` 前缀的变量
# 都会被直接编译进 dist/ 并下发到客户端。
# --------------------------------------------------------------------------

# Xboard 后端基础地址（必填）
VITE_API_BASE_URL=https://board.example.com

# 管理后台路径，对应后端 dashboard secure path
VITE_DASHBOARD_SECURE_PATH=admin

# 浏览器侧后台路径前缀（与 router 配合）
VITE_FRONTEND_SECURE_PATH=admin

# 登录接口可选覆盖（默认 = ${API_BASE_URL}/api/v2/passport/auth/login）
# VITE_AUTH_LOGIN_URL=https://board.example.com/api/v2/passport/auth/login

# Dashboard 统计接口可选覆盖
# VITE_DASHBOARD_STATS_URL=https://board.example.com/api/v3/admin/stat/getStats

# ⚠️ 历史上这里曾示例 VITE_DASHBOARD_API_TOKEN —— 不要再使用。
# 任何写在 .env 的 VITE_ 变量都会被前端 bundle 暴露给所有浏览器用户。
# 会话 token 应由用户登录流程从 /passport/auth/login 返回的 auth_data 中获得，
# 由 stores/auth 自动持有，调用方无需手工配置 token。
